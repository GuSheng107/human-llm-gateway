APP_NAME=human-llm-gateway
DATABASE_URL=sqlite:///./data/human_llm_gateway.db
APP_SECRET=replace-with-a-long-random-secret
# APP_SECRET 必须是 32 字节 CSPRNG 随机值的 base64url（43 字符）。
# 生成示例：python -c "import secrets;print(secrets.token_urlsafe(32))"
# 缺失、长度不符或仍为上面的示例默认值时，服务启动直接失败。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
HUMAN_TIMEOUT_SECONDS=300
STREAM_CHUNK_SIZE=24
STREAM_DELAY_MIN_MS=20
STREAM_DELAY_MAX_MS=90
ALLOW_PLAIN_HUMAN_REPLY=true
BINDING_CODE_TTL_SECONDS=300
CONNECTION_WATCHDOG_INTERVAL_SECONDS=60
LLM_ALLOW_PRIVATE_UPSTREAM=false
# 本网关对外的公网域名/IP（逗号分隔，可带端口）。公网部署必须填写：
# 防止用户把 LLM 上游 base_url 指回本网关自身形成自指转发链。
GATEWAY_PUBLIC_HOSTS=
TOOL_SANDBOX_RUNTIME=auto
TOOL_SANDBOX_IMAGE=human-llm-gateway-tool-sandbox:latest
TOOL_SANDBOX_MEMORY_MB=256
TOOL_SANDBOX_CPUS=1.0
TOOL_SANDBOX_PIDS_LIMIT=64
TOOL_SANDBOX_TMPFS_MB=64
